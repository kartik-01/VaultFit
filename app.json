{
  "expo": {
    "name": "VaultFit",
    "slug": "VaultFit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vaultfit.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "VaultFit needs access to your location to accurately record your workout routes.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "VaultFit needs background location to continue recording your route when your screen is locked or the app is closed.",
        "NSHealthShareUsageDescription": "VaultFit needs access to your health data to analyze your workouts securely.",
        "NSHealthUpdateUsageDescription": "VaultFit saves your secure workout data to Apple Health."
      }
    },
    "android": {
      "package": "com.vaultfit.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEART_RATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "react-native-libsodium",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true,
          "ios": {
            "customBuildFlags": [
              "-DSQLITE_HAS_CODEC"
            ]
          },
          "android": {
            "useSQLCipher": true
          }
        }
      ],
      "expo-secure-store",
      "expo-build-properties",
      "expo-location",
      "expo-asset",
      "expo-font"
    ]
  }
}
